# 学校对应的小程序业务域名；必须为 HTTPS origin，不能包含路径或凭据。
# 留空配置时默认 https://wxxcx.xtotoro.com。
SUNRUN_MINIPROGRAM_BASE_URL=https://wxxcx.xtotoro.com

# 完整跑步回归默认只走内存 Mock，不产生网络请求。
SUNRUN_REGRESSION_MODE=mock

# 仅在使用后端已隔离的回归 Token 时同时设置为 test / true。
# 测试目标可以是 HTTPS 测试 origin，也可以是原接口 https://wxxcx.xtotoro.com。
SUNRUN_REGRESSION_ALLOW_TEST_SUBMIT=false
